{
  "name": "outcomeeng",
  "metadata": {
    "description": "Outcome Engineering plugin marketplace for Codex and Claude Code",
    "pluginRoot": "./dist/claude"
  },
  "owner": {
    "name": "Simon Heimlicher"
  },
  "plugins": [
    {
      "name": "instructions",
      "source": "./dist/claude/instructions",
      "description": "Instruction authoring: /author-skill, /author-subagent"
    },
    {
      "name": "frontend",
      "source": "./dist/claude/frontend",
      "description": "Frontend design: /design-frontend skill"
    },
    {
      "name": "typescript",
      "source": "./dist/claude/typescript",
      "description": "TypeScript engineering: /author-typescript-test, /author-typescript-code, /audit-typescript-code, /audit-typescript-test, /audit-typescript-architecture, /author-typescript-architecture, /simplify-typescript-code"
    },
    {
      "name": "python",
      "source": "./dist/claude/python",
      "description": "Python engineering: /author-python-test, /author-python-code, /audit-python-code, /audit-python-test, /audit-python-architecture, /author-python-architecture"
    },
    {
      "name": "prose",
      "source": "./dist/claude/prose",
      "description": "Prose craft through a matched triple (/author-prose-architecture, /author-prose, /audit-prose) over caller-supplied kind layers: interface, documentation, copy"
    },
    {
      "name": "spec-tree",
      "source": "./dist/claude/spec-tree",
      "description": "Spec Tree: /understand, /contextualize, /bootstrap, /author, /decompose, /refactor, /align, /interview, /test, /audit-tests, /audit-eval-evidence, /audit-adr, /audit-pdr, /audit-implementation, /audit-specs, /audit-changeset-coherence, /apply, /commit-changes, /claim-change, /release-change, /close-change, /refocus, /diagnose"
    },
    {
      "name": "coding-agents",
      "source": "./dist/claude/coding-agents",
      "description": "Coding-agent environments, coordination, and change orchestration: /operate-prowl, /operate-herdr, /operate-agent-mail, /message-agents, /coordinate-agents, /recover-prowl-agents, /orchestrate-change"
    },
    {
      "name": "work",
      "source": "./dist/claude/work",
      "description": "Work deliverables: /draw-excalidraw (Excalidraw diagrams), /sanitize-powerpoint (PowerPoint deck cleanup)"
    },
    {
      "name": "hdl",
      "source": "./dist/claude/hdl",
      "description": "HDL engineering: /review-vhdl, /review-systemverilog (idiomatic VHDL-2008 and SystemVerilog IEEE 1800-2017 review)"
    },
    {
      "name": "rust",
      "source": "./dist/claude/rust",
      "description": "Rust engineering: /author-rust-test, /author-rust-code, /audit-rust-code, /audit-rust-test, /audit-rust-architecture, /author-rust-architecture, /simplify-rust-code"
    },
    {
      "name": "go",
      "source": "./dist/claude/go",
      "description": "Go engineering: /author-go-test, /author-go-code, /audit-go-code, /audit-go-test, /audit-go-architecture, /author-go-architecture, /simplify-go-code"
    },
    {
      "name": "contribute",
      "source": "./dist/claude/contribute",
      "description": "Contributions to repositories you do not control: /upstream, /open-upstream-pr, /manage-upstream-pr, /open-upstream-issue, /manage-upstream-issue, /sync-fork"
    }
  ]
}
