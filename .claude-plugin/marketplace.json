{
  "name": "outcomeeng",
  "metadata": {
    "description": "Outcome Engineering plugin marketplace for Codex and Claude Code",
    "pluginRoot": "./dist/claude"
  },
  "owner": {
    "name": "Simon Heimlicher"
  },
  "plugins": [
    {
      "name": "develop",
      "source": "./dist/claude/develop",
      "description": "Plugin development: /create-skills, /create-commands, /create-subagents"
    },
    {
      "name": "frontend",
      "source": "./dist/claude/frontend",
      "description": "Frontend design: /design-frontend skill"
    },
    {
      "name": "typescript",
      "source": "./dist/claude/typescript",
      "description": "TypeScript engineering: /test-typescript, /code-typescript, /audit-typescript, /architect-typescript, /audit-typescript-architecture, typescript-simplifier agent"
    },
    {
      "name": "python",
      "source": "./dist/claude/python",
      "description": "Python engineering: /test-python, /code-python, /audit-python, /architect-python, /audit-python-architecture"
    },
    {
      "name": "prose",
      "source": "./dist/claude/prose",
      "description": "Prose craft for external prose (/write-prose, /audit-prose) and internal team docs (/write-internal-docs, /audit-internal-docs)"
    },
    {
      "name": "spec-tree",
      "source": "./dist/claude/spec-tree",
      "description": "Spec Tree: /understand, /contextualize, /bootstrap, /author, /decompose, /refactor, /align, /interview, /test, /audit-tests, /audit-adr, /audit-pdr, /apply, /commit-changes, /bootstrap, /author, /commit, /handoff, /pickup, /rtfm, /clarify"
    },
    {
      "name": "work",
      "source": "./dist/claude/work",
      "description": "Work deliverables: /draw-excalidraw (Excalidraw diagrams), /sanitize-powerpoint (PowerPoint deck cleanup)"
    },
    {
      "name": "hdl",
      "source": "./dist/claude/hdl",
      "description": "HDL engineering: /review-vhdl, /review-systemverilog (idiomatic VHDL-2008 and SystemVerilog IEEE 1800-2017 review)"
    },
    {
      "name": "rust",
      "source": "./dist/claude/rust",
      "description": "Rust engineering: /test-rust, /code-rust, /audit-rust, /architect-rust, /audit-rust-architecture"
    }
  ]
}
