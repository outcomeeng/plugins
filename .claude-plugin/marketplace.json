{
  "name": "outcomeeng",
  "metadata": {
    "description": "Outcome Engineering plugin marketplace for Codex and Claude Code",
    "pluginRoot": "./dist/claude"
  },
  "owner": {
    "name": "Simon Heimlicher"
  },
  "plugins": [
    {
      "name": "instructions",
      "source": "./dist/claude/instructions",
      "description": "Instruction authoring: /create-skill, /create-subagent"
    },
    {
      "name": "frontend",
      "source": "./dist/claude/frontend",
      "description": "Frontend design: /design-frontend skill"
    },
    {
      "name": "typescript",
      "source": "./dist/claude/typescript",
      "description": "TypeScript engineering: /test-typescript, /code-typescript, /audit-typescript-code, /audit-typescript-tests, /audit-typescript-architecture, /architect-typescript, typescript-simplifier agent"
    },
    {
      "name": "python",
      "source": "./dist/claude/python",
      "description": "Python engineering: /test-python, /code-python, /audit-python-code, /audit-python-tests, /audit-python-architecture, /architect-python"
    },
    {
      "name": "prose",
      "source": "./dist/claude/prose",
      "description": "Prose craft through a matched triple (/architect-prose, /author-prose, /audit-prose) over caller-supplied kind layers: interface, documentation, copy"
    },
    {
      "name": "spec-tree",
      "source": "./dist/claude/spec-tree",
      "description": "Spec Tree methodology for declaration, context loading, evidence, implementation, review, sessions, and delivery"
    },
    {
      "name": "coding-agents",
      "source": "./dist/claude/coding-agents",
      "description": "Coding-agent environments and coordination: /operate-prowl, /message-agents, /coordinate-agents, /recover-prowl-agents"
    },
    {
      "name": "work",
      "source": "./dist/claude/work",
      "description": "Work deliverables: /draw-excalidraw (Excalidraw diagrams), /sanitize-powerpoint (PowerPoint deck cleanup)"
    },
    {
      "name": "hdl",
      "source": "./dist/claude/hdl",
      "description": "HDL engineering: /review-vhdl, /review-systemverilog (idiomatic VHDL-2008 and SystemVerilog IEEE 1800-2017 review)"
    },
    {
      "name": "rust",
      "source": "./dist/claude/rust",
      "description": "Rust engineering: /test-rust, /code-rust, /audit-rust-code, /audit-rust-tests, /audit-rust-architecture, /architect-rust, rust-simplifier agent"
    },
    {
      "name": "contribute",
      "source": "./dist/claude/contribute",
      "description": "Contributions to repositories you do not control: /open-parent-pr, /manage-parent-pr, /open-parent-issue, /manage-parent-issue, /sync-fork"
    }
  ]
}
