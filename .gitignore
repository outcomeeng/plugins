# AI agent settings
.claude/*
!.claude/settings.json
.codex/*
!.codex/config.toml
# Project-local skills stay local; shipped skills route through src/plugins/ -> dist/
.agents/skills/
.pi/*
!.pi/claude-plugins.json

# Subagent run transcripts (local tool output; never committed)
.pi-subagents/

# Local MCP server registration (machine-specific absolute paths)
.mcp.json

# Agent memories staged for consolidation into skills (local only)
methodology/memories/

# Agent runtime operational files
/.pi/
.spx/

# Per-eval run transcripts (ephemeral; history.jsonl is the committed trend record)
**/evals/*/runs/

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node.js (if using markdown tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if using markdown tooling)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.hypothesis/

# Build outputs
build/
out/
/outcomeeng-spx-*.tgz

# Temporary files
*.tmp
*.temp
*.bak
*.orig
/.coverage
/coverage.json

# Worktrees
.work/*
