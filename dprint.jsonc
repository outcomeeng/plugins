{
  // Python is formatted by the project's ruff (pyproject.toml), enforced by the
  // gate's `ruff format --check` step. dprint's bundled ruff plugin pins a ruff
  // version that drifts from the uv-locked toolchain, so it is intentionally absent
  // and `py` is intentionally absent from `includes`.
  "includes": [
    "**/*.{ts,tsx,js,jsx,json,jsonc,md,mdx,toml,yaml,yml,css,scss,html,vue,svelte}",
  ],
  "excludes": [
    "**/node_modules",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/.spx/sessions/**",
    "**/.spx/reviews/**",
    "**/.pi-subagents/**",
    "**/*-lock.json",
    "**/semgrep_*.yaml",
    "outcomeeng/vendor/**",
    "pyproject.toml",
    // Generated producer-coupled eval prompts: `outcomeeng-evals
    // materialize-prompts` is their sole writer and its `--check` form is
    // their drift gate, so the formatter never rewrites their bytes.
    "spx/**/evals/**/prompt.md",
  ],
  "dockerfile": {},
  "json": {
    "trailingCommas": "jsonc",
    "array.preferSingleLine": false,
    "object.preferSingleLine": false,
  },
  "jupyter": {},
  "malva": {},
  "markdown": {
    "associations": ["**/*.md", "**/*.mdx"],
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "textWrap": "maintain",
    "unorderedListKind": "dashes",
    "lineWidth": 9999,
  },
  "markup": {
    "associations": ["!**/*.md", "!**/layouts/**/*"],
    "closingBracketSameLine": false,
    "singleAttrSameLine": false,
    "printWidth": 9999,
  },
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.13.wasm",
    "https://plugins.dprint.dev/json-0.21.1.wasm",
    "https://plugins.dprint.dev/markdown-0.20.0.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.3.3.wasm",
    "https://plugins.dprint.dev/jupyter-0.2.1.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.15.1.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.25.3.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.1.wasm",
  ],
  "toml": {},
  "typescript": {},
  "yaml": {},
}
