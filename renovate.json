{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(ci)",
    ":dependencyDashboard"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Disable Renovate digest pinning for beta outcomeeng/gh-actions reusable-workflow callers that intentionally track @main.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["outcomeeng/gh-actions"],
      "matchFileNames": [
        ".github/workflows/spec-tree.yml",
        ".github/workflows/spec-tree-review.yml"
      ],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions and reusable-workflow updates. Digest pinning itself is enforced by the helpers:pinGitHubActionDigests preset above; this rule only adds the grouping.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ],
  "customManagers": [
    {
      "description": "Track CLI tool versions pinned in workflows and distribution build source. Each pin carries an inline `# renovate: datasource=... depName=...` annotation naming its source.",
      "customType": "regex",
      "managerFilePatterns": [
        "^\\.github/workflows/spec-tree-evals\\.yml$",
        "^\\.github/workflows/check\\.yml$",
        "^\\.github/workflows/refresh-instruction-blocks\\.yml$",
        "^outcomeeng/distribution/build\\.py$"
      ],
      "matchStrings": [
        "\"(?<currentValue>[^\"]+)\"\\s+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
