{"id": "installed-both-surfaces-current", "input": {"surfaces": [{"surface": "claude", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}, {"name": "develop", "installed": true, "enabled": true, "installed_version": "0.10.3", "offered_version": "0.10.3"}]}, {"surface": "codex", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}]}]}, "expected_verdict": {"must_contain": [{"verdict": "installed", "bucket": "healthy", "remediation": null}], "must_not_contain": [{"verdict": "drifted"}, {"bucket": "degraded"}]}}
{"id": "drifted-codex-surface-stale", "input": {"surfaces": [{"surface": "claude", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}]}, {"surface": "codex", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.3", "offered_version": "0.61.4"}]}]}, "expected_verdict": {"must_contain": [{"verdict": "drifted", "bucket": "degraded", "remediation": "#string"}], "must_not_contain": [{"verdict": "installed"}, {"bucket": "healthy"}]}}
{"id": "drifted-plugin-disabled", "input": {"surfaces": [{"surface": "claude", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}, {"name": "develop", "installed": true, "enabled": false, "installed_version": "0.10.3", "offered_version": "0.10.3"}]}, {"surface": "codex", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}]}]}, "expected_verdict": {"must_contain": [{"verdict": "drifted", "bucket": "degraded", "remediation": "#string"}], "must_not_contain": [{"verdict": "installed"}, {"bucket": "healthy"}]}}
{"id": "drifted-plugin-missing", "input": {"surfaces": [{"surface": "claude", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}, {"name": "develop", "installed": false, "enabled": false, "installed_version": null, "offered_version": "0.10.3"}]}]}, "expected_verdict": {"must_contain": [{"verdict": "drifted", "bucket": "degraded", "remediation": "#string"}], "must_not_contain": [{"verdict": "installed"}, {"bucket": "healthy"}]}}
{"id": "drifted-missing-cross-surface", "input": {"surfaces": [{"surface": "claude", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}, {"name": "develop", "installed": false, "enabled": false, "installed_version": null, "offered_version": "0.10.3"}]}, {"surface": "codex", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}]}]}, "expected_verdict": {"must_contain": [{"verdict": "drifted", "bucket": "degraded", "remediation": "#string"}], "must_not_contain": [{"verdict": "installed"}, {"bucket": "healthy"}]}}
{"id": "unregistered-claude-surface", "input": {"surfaces": [{"surface": "claude", "present": true, "registered": false, "plugins": []}, {"surface": "codex", "present": true, "registered": true, "plugins": [{"name": "spec-tree", "installed": true, "enabled": true, "installed_version": "0.61.4", "offered_version": "0.61.4"}]}]}, "expected_verdict": {"must_contain": [{"verdict": "unregistered", "bucket": "broken", "remediation": "#string"}], "must_not_contain": [{"verdict": "installed"}, {"verdict": "drifted"}]}}
{"id": "not-applicable-no-plugin-cli", "input": {"surfaces": [{"surface": "claude", "present": false, "registered": false, "plugins": []}, {"surface": "codex", "present": false, "registered": false, "plugins": []}]}, "expected_verdict": {"must_contain": [{"verdict": "not-applicable", "bucket": "not-applicable", "remediation": null}], "must_not_contain": [{"verdict": "installed"}, {"verdict": "drifted"}, {"bucket": "broken"}]}}
{"id": "unknown-marketplace-list-errors", "input": {"surfaces": [{"surface": "claude", "present": true, "error": "claude plugin marketplace list failed: exit 1"}]}, "expected_verdict": {"must_contain": [{"verdict": "unknown", "bucket": "unknown", "remediation": "#string"}], "must_not_contain": [{"verdict": "installed"}, {"bucket": "healthy"}]}}
