{"id": "reachable-above-floor", "input": {"command_v_spx": "/opt/homebrew/bin/spx", "spx_version": "0.61.0", "floor": "0.5.6"}, "expected_verdict": {"must_contain": [{"verdict": "reachable", "bucket": "healthy", "path": "/opt/homebrew/bin/spx", "version": "0.61.0", "remediation": null}], "must_not_contain": [{"verdict": "below-floor"}, {"bucket": "broken"}, {"version": "0.61"}]}}
{"id": "reachable-equals-floor", "input": {"command_v_spx": "/opt/homebrew/bin/spx", "spx_version": "0.5.6", "floor": "0.5.6"}, "expected_verdict": {"must_contain": [{"verdict": "reachable", "bucket": "healthy", "version": "0.5.6", "remediation": null}], "must_not_contain": [{"verdict": "below-floor"}, {"bucket": "degraded"}]}}
{"id": "below-floor-old-version", "input": {"command_v_spx": "/opt/homebrew/bin/spx", "spx_version": "0.5.4", "floor": "0.5.6"}, "expected_verdict": {"must_contain": [{"verdict": "below-floor", "bucket": "degraded", "path": "/opt/homebrew/bin/spx", "version": "0.5.4", "remediation": "#string"}], "must_not_contain": [{"verdict": "reachable"}, {"bucket": "healthy"}]}}
{"id": "unreachable-not-on-path", "input": {"command_v_spx": null, "spx_version": null, "floor": "0.5.6"}, "expected_verdict": {"must_contain": [{"verdict": "unreachable", "bucket": "broken", "remediation": "#string"}], "must_not_contain": [{"verdict": "reachable"}, {"bucket": "healthy"}]}}
{"id": "unknown-version-command-errors", "input": {"command_v_spx": "/opt/homebrew/bin/spx", "spx_version": {"error": "spx: command failed with exit code 1"}, "floor": "0.5.6"}, "expected_verdict": {"must_contain": [{"verdict": "unknown", "bucket": "unknown", "remediation": "#string"}], "must_not_contain": [{"verdict": "reachable"}, {"bucket": "healthy"}]}}
{"id": "unknown-non-numeric-version", "input": {"command_v_spx": "/opt/homebrew/bin/spx", "spx_version": "0.6.0-rc.1", "floor": "0.5.6"}, "expected_verdict": {"must_contain": [{"verdict": "unknown", "bucket": "unknown", "remediation": "#string"}], "must_not_contain": [{"verdict": "reachable"}, {"bucket": "healthy"}, {"verdict": "below-floor"}]}}
